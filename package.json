{
  "name": "otilc-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Vitrine da pré-venda OTILC (Drop 00): site estático, sem build, em HTML, CSS e JavaScript modular.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serve . -l 8080",
    "images": "node scripts/optimize-images.js",
    "screenshots": "node scripts/screenshots.js",
    "site-url": "node scripts/set-site-url.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "node scripts/lighthouse-local.js",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "sharp": "^0.35.5"
  }
}
